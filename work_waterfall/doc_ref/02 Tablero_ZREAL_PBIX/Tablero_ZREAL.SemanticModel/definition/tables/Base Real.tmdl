	column ZonaHuerfana
		dataType: string
		lineageTag: e07f54b4-d88a-4af9-aa7a-9ff5d4976cb5
		summarizeBy: none
		sourceColumn: ZonaHuerfana

		annotation SummarizationSetBy = Automatic

	partition 'Base Real' = m
		mode: import
		source =
				let
				    Origen = Excel.Workbook(File.Contents(RutaArchivo), null, true),
				    BaseReal = Origen{[Item="Base Real",Kind="Sheet"]}[Data],
				    Encabezados = Table.PromoteHeaders(BaseReal, [PromoteAllScalars=true]),
				    Sel = Table.SelectColumns(Encabezados, {
				        "Sociedad","EMPRESA","Centro de coste","Clase de coste","Denom.clase de coste",
				        "Valor/mon.inf.","TIPO CECO","CODIGO NEGOCIO/AREA","CODIGO PRODUCTO/SECTOR",
				        "NEGOCIO/AREA","PRODUCTO/SECTOR","GRUPO AREA","Denominación de la cuenta",
				        "RUBRO EBITDA","VERTICAL","ZONA","mes año"
				    }),
				    CECO = Table.AddColumn(Sel, "CECO", each Text.Trim(Text.From([#"Centro de coste"])), type text),
				    Letra = Table.AddColumn(CECO, "Letra", each Text.Start([CECO],1), type text),
				    NegArea = Table.AddColumn(Letra, "NegArea", each Text.Middle([CECO],1,2), type text),
				    ProdSector = Table.AddColumn(NegArea, "ProdSector", each Text.Middle([CECO],3,3), type text),
				    ZonaCECO = Table.AddColumn(ProdSector, "ZonaCECO", each Text.Middle([CECO],6,4), type text),
				    Tipologia = Table.AddColumn(ZonaCECO, "Tipologia", each
				        if [NegArea]="LE" then "Locación"
				        else if Text.Select([NegArea],{"0".."9"})=[NegArea] then "Directo"
				        else "Indirecto", type text),
				    ZonaHuerfana = Table.AddColumn(Tipologia, "ZonaHuerfana", each
				        if List.Contains({"901C","902B","902C","915E","916E"}, [ZonaCECO])
				        then "HUÉRFANA (alta V106 pendiente)" else "OK", type text),
				    Tipado = Table.TransformColumnTypes(ZonaHuerfana, {
				        {"Sociedad", type text},{"EMPRESA", type text},{"Centro de coste", type text},
				        {"Clase de coste", type text},{"Denom.clase de coste", type text},
				        {"Valor/mon.inf.", type number},{"TIPO CECO", type text},
				        {"CODIGO NEGOCIO/AREA", type text},{"CODIGO PRODUCTO/SECTOR", type text},
				        {"NEGOCIO/AREA", type text},{"PRODUCTO/SECTOR", type text},{"GRUPO AREA", type text},
				        {"Denominación de la cuenta", type text},{"RUBRO EBITDA", type text},
				        {"VERTICAL", type text},{"ZONA", type text},{"mes año", type datetime}
				    })
				in
				    Tipado

	annotation PBI_ResultType = Exception

