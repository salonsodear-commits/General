table 'Base Real'
	lineageTag: b5c2edb3-672e-41fc-99d4-f7bd758101a6

	measure 'OPEX Total' = SUM ( 'Base Real'[Valor/mon.inf.] )
		formatString: #,0
		lineageTag: 9216d247-2cbc-4d87-a06e-041d8f4075ea

	measure 'OPEX Directo' = CALCULATE ( [OPEX Total], 'Base Real'[TIPO CECO] = "Directo" )
		formatString: #,0
		lineageTag: b9f180b7-7cb7-4fcf-ac4c-48bf279d9746

	measure 'OPEX Indirecto' = CALCULATE ( [OPEX Total], 'Base Real'[TIPO CECO] = "Indirecto" )
		formatString: #,0
		lineageTag: 8c1171e5-626c-4455-a55b-f063f5a7bdf7

	measure '% Directo' = DIVIDE ( [OPEX Directo], [OPEX Total] )
		formatString: 0.0%
		lineageTag: 686666bc-52a2-4da8-bab1-3ffcc49dd254

	measure '% Indirecto' = DIVIDE ( [OPEX Indirecto], [OPEX Total] )
		formatString: 0.0%
		lineageTag: f05207cc-76d6-417b-86cd-763bf35055d5

	measure 'OPEX Indirecto Transversal' = CALCULATE ( [OPEX Indirecto], NOT ( 'Base Real'[CODIGO PRODUCTO/SECTOR] IN { "N03", "N10", "N12", "N16", "C13" } ) )
		formatString: #,0
		lineageTag: c59316e9-9f75-497e-8327-b7bc9639aabf

	measure 'OPEX Indirecto Dedicado OC' = CALCULATE ( [OPEX Indirecto], 'Base Real'[CODIGO PRODUCTO/SECTOR] IN { "N03", "N10", "N12", "N16", "C13" } )
		formatString: #,0
		lineageTag: 2b36573f-01e2-41bf-90a4-cda32519ad76

